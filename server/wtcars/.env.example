# Скопировать в server/wtcars/.env на сервере и заполнить.
# Файл в .gitignore — секреты в репозиторий не попадают.

# --- база ---
# прод:   postgresql+asyncpg://wtcars:ПАРОЛЬ@127.0.0.1:5432/wtcars
# локально: sqlite+aiosqlite:///./wtcars.db
DATABASE_URL=sqlite+aiosqlite:///./wtcars.db

# --- Telegram ---
# Токен бота калькулятора (@wt_car_calc_bot) — по нему проверяется initData.
WT_BOT_TOKEN=

# --- сессии Mini App ---
# Сгенерировать: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
WT_JWT_SECRET=
JWT_TTL_DAYS=30
AUTH_MAX_AGE=86400

# Кто имеет доступ. Пусто = любой, прошедший проверку подписи.
# Заполнить своим telegram_id сразу после первого входа.
OWNER_TELEGRAM_IDS=

# --- CORS ---
ALLOWED_ORIGINS=https://dmitriisavitskii1993.github.io

# --- файлы ---
STORAGE_DIR=/var/lib/wtcars
MAX_PHOTO_BYTES=15728640
MAX_PHOTOS_PER_CAR=20
AI_IMAGE_MAX_EDGE=1568

# --- Anthropic (этап 2) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Обогащение с drom.ru. По умолчанию off: см. риск 1 в плане
# (ГК ст. 1334/1335.1) и +$0.075 к стоимости каждого авто.
DROM_ENRICH=off

# --- PublioSMM (этап 3) ---
PUBLIO_API_BASE=http://127.0.0.1:8081/api
PUBLIO_SERVICE_TOKEN=

DEBUG=off
